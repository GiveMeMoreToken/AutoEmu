# AutoEmu configuration file
# Copy to .autoemu.toml in your working directory.
# Values here override environment variables.

[agent]
# Backend: "harness" (default, no AI), "claude-sdk", "codex-sdk",
# "anthropic-api", or "openai-api"
backend = "harness"

# LLM model override (optional, backend-specific)
# model = "claude-sonnet-4-20250514"

# Maximum spend per pipeline run (USD)
# max_budget_usd = 5.0

# API keys (alternatively set ANTHROPIC_API_KEY / OPENAI_API_KEY env vars)
# anthropic_api_key = "sk-ant-..."
# openai_api_key = "sk-..."

# Base URLs for API proxies or self-hosted endpoints
# (alternatively set ANTHROPIC_BASE_URL / OPENAI_BASE_URL env vars)
# anthropic_base_url = "https://api.anthropic.com"
# openai_base_url = "https://api.openai.com/v1"

[validation]
# Optional QEMU source tree for generated-code compatibility checks.
# Use an existing checkout, or "latest" to clone/update the upstream master
# branch in AutoEmu's managed cache.
# qemu_src = "/path/to/qemu"
# qemu_src = "latest"
